<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <PropertyGroup>
    <ProjectGuid>{7E24F9DE-BEEF-4362-8CD7-B827CD8B2337}</ProjectGuid>
    <ProjectTypeGuids>{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <BaseIntermediateOutputPath>..\obj\$(Configuration)\AsmStudio\</BaseIntermediateOutputPath>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <!-- Debug/Release 均为纯窗体（独立控制台已移除，日志在主窗口"执行日志"页） -->
    <OutputType>WinExe</OutputType>
    <!-- exe 级 Win32 图标：任务栏/资源管理器/快捷方式用（运行时 Form.Icon 仅管窗口标题）。
         x86 构建右下角标 32，其余（AnyCPU/x64）标 64 -->
    <ApplicationIcon Condition=" '$(Platform)' == 'x86' ">Resources\Icons\app_32.ico</ApplicationIcon>
    <ApplicationIcon Condition=" '$(Platform)' != 'x86' ">Resources\Icons\app_64.ico</ApplicationIcon>
    <RootNamespace>AsmStudio</RootNamespace>
    <AssemblyName>AsmStudio</AssemblyName>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Platform)' == 'AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Platform)' == 'x86' ">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Platform)' == 'x64' ">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>..\bin\$(Configuration)\x64\</OutputPath>
    <DebugSymbols>True</DebugSymbols>
    <DebugType>Full</DebugType>
    <Optimize>False</Optimize>
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\bin\$(Configuration)\x64\</OutputPath>
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
    <Optimize>True</Optimize>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <OutputPath>..\bin\$(Configuration)\x86\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <OutputPath>..\bin\$(Configuration)\x86\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp">
      <RequiredTargetFramework>4.0</RequiredTargetFramework>
      <Private>False</Private>
    </Reference>
    <Reference Include="System">
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Core">
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Drawing">
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Web.Extensions">
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Windows.Forms">
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Xml">
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Xml.Linq">
      <RequiredTargetFramework>3.5</RequiredTargetFramework>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="AppConfig.cs" />
    <Compile Include="Localization\LanguageService.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="SchemePickForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Controls\AsmEditor.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Include="Controls\PickHintForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Controls\EditorTheme.cs" />
    <Compile Include="Engine\AsmSyntax.cs" />
    <Compile Include="Engine\Lexicon\InstructionLexicon.cs" />
    <Compile Include="Engine\Lexicon\RegisterLexicon.cs" />
    <Compile Include="Engine\InstructionTables.cs" />
    <Compile Include="Engine\Lexer.cs" />
    <Compile Include="Engine\SyntaxConverter.cs" />
    <Compile Include="Engine\IntelAssembler.cs" />
    <Compile Include="Engine\AtAndTAssembler.cs" />
    <Compile Include="Engine\Encoder.cs" />
    <Compile Include="Engine\Assembler.cs" />
    <Compile Include="Engine\AsmEngine.cs" />
    <Compile Include="Engine\TestVectors.cs" />
    <Compile Include="Remote\NativeInterop.cs" />
    <Compile Include="Remote\ExecutionResult.cs" />
    <Compile Include="Remote\ProcessScanner.cs" />
    <Compile Include="Remote\ProcessPicker.cs" />
    <Compile Include="Remote\RemoteThreadExecutor.cs" />
    <Compile Include="Remote\AsmVeh.cs" />
    <Compile Include="Remote\RemoteSymbols.cs" />
    <Compile Include="Remote\ProcDiag.cs" />
    <Compile Include="Remote\TargetSession.cs" />
    <Compile Include="Schemes\SchemeFile.cs" />
    <Compile Include="Schemes\SchemeRunner.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\StringResources.resx">
      <LogicalName>AsmStudio.StringResources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\StringResources.zhCN.resx">
      <LogicalName>AsmStudio.StringResources.zhCN.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Properties\AppResources.resx">
      <LogicalName>AsmStudio.AppResources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Icons\app_32.ico">
      <LogicalName>AsmStudio.Icons.app_32.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Icons\app_64.ico">
      <LogicalName>AsmStudio.Icons.app_64.ico</LogicalName>
    </EmbeddedResource>
    <!-- 拖拽取进程：准星光标 + 工具栏图标（源文件来自火山版截图助手的 img\zz.cur、img\1.png） -->
    <EmbeddedResource Include="Resources\zz.cur">
      <LogicalName>AsmStudio.Resources.zz.cur</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\pick.png">
      <LogicalName>AsmStudio.Resources.pick.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- 方案脚本（Resources\Schemes\），Link 保持输出扁平 exe\Resources\
         语言资源改为内嵌 resx（Properties\StringResources*.resx），不再用外部 txt
         用通配符：新增 .asmscheme 自动进输出目录，不必再手工加 Content 项 -->
    <Content Include="Resources\Schemes\*.asmscheme">
      <Link>Resources\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Resources\Schemes" />
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets" />
  <!-- 无 targeting pack 时框架程序集/mscorlib/norm*.nlp 会误复制到输出目录，构建后清理。
       用 MSBuildProjectDirectory 锚定输出根：命令行传相对 OutputPath 时它按进程 cwd 解析会指错。
       x64/x86 两个输出目录都清理（批处理双架构构建共用本工程） -->
  <Target Name="RemoveFrameworkCopies" AfterTargets="Build">
    <Delete Files="$(MSBuildProjectDirectory)\..\bin\$(Configuration)\x64\mscorlib.dll;$(MSBuildProjectDirectory)\..\bin\$(Configuration)\x86\mscorlib.dll" />
    <Delete Files="$(MSBuildProjectDirectory)\..\bin\$(Configuration)\x64\normidna.nlp;$(MSBuildProjectDirectory)\..\bin\$(Configuration)\x64\normnfc.nlp;$(MSBuildProjectDirectory)\..\bin\$(Configuration)\x64\normnfd.nlp;$(MSBuildProjectDirectory)\..\bin\$(Configuration)\x64\normnfkc.nlp;$(MSBuildProjectDirectory)\..\bin\$(Configuration)\x64\normnfkd.nlp;$(MSBuildProjectDirectory)\..\bin\$(Configuration)\x86\normidna.nlp;$(MSBuildProjectDirectory)\..\bin\$(Configuration)\x86\normnfc.nlp;$(MSBuildProjectDirectory)\..\bin\$(Configuration)\x86\normnfd.nlp;$(MSBuildProjectDirectory)\..\bin\$(Configuration)\x86\normnfkc.nlp;$(MSBuildProjectDirectory)\..\bin\$(Configuration)\x86\normnfkd.nlp" />
  </Target>
</Project>