{
  "name": "AT&T 调用 GameAddScore(5)",
  "description": "AT&T(GAS) 语法: $符号取地址、call *%rax 间接调用",
  "syntax": "att",
  "arch": "x64",
  "steps": [
    {
      "title": "加 5 分（AT&T）",
      "mode": "code",
      "code": "movq $5, %rcx\nmovq $GameAddScore, %rax\ncall *%rax\nret",
      "timeout_ms": 3000
    },
    {
      "title": "读取得分",
      "mode": "code",
      "code": "movq $GameGetScore, %rax\ncall *%rax\nret",
      "timeout_ms": 3000
    },
    {
      "title": "治疗 20 点",
      "mode": "call",
      "call": "GameHeal",
      "args": ["20"],
      "timeout_ms": 3000
    }
  ]
}
