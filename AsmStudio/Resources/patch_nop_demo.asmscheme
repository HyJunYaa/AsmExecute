{
  "name": "远程补丁演示（GameSlowCall 提速）",
  "description": "先调用慢函数（约2秒）→ 调用 VirtualProtect 解除代码页写保护 → 远程写入 'mov eax,0 / ret'（6字节）→ 再调用瞬间返回。展示真实场景的跨进程补丁流程。",
  "syntax": "intel",
  "arch": "x64",
  "steps": [
    {
      "title": "慢函数（打补丁前，约 2 秒）",
      "mode": "call",
      "call": "GameSlowCall",
      "timeout_ms": 10000
    },
    {
      "title": "VirtualProtect(GameSlowCall, 64, PAGE_EXECUTE_READWRITE=0x40, &g_pos)",
      "mode": "call",
      "call": "VirtualProtect",
      "args": ["GameSlowCall", "64", "64", "g_pos"],
      "timeout_ms": 3000
    },
    {
      "title": "写入补丁字节: B8 00 00 00 00 C3 (mov eax,0 / ret)",
      "mode": "code",
      "code": "mov rcx, GameSlowCall\nmov dword ptr [rcx], 0xB8\nmov word ptr [rcx+4], 0xC300\nret",
      "timeout_ms": 3000
    },
    {
      "title": "慢函数（打补丁后瞬间完成）",
      "mode": "call",
      "call": "GameSlowCall",
      "timeout_ms": 3000
    },
    {
      "title": "恢复代码页保护: VirtualProtect(GameSlowCall, 64, 0x20, &g_pos)",
      "mode": "call",
      "call": "VirtualProtect",
      "args": ["GameSlowCall", "64", "32", "g_pos"],
      "timeout_ms": 3000
    }
  ]
}
