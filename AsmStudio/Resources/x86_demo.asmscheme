{
  "name": "x86 目标演示（cdecl 调用）",
  "description": "x86 目标使用 cdecl: 参数从右向左压栈、调用方清栈；g_score 数据槽用绝对寻址",
  "syntax": "intel",
  "arch": "x86",
  "steps": [
    {
      "title": "加 5 分（用户代码内嵌 cdecl 调用）",
      "mode": "code",
      "code": "mov eax, GameAddScore\npush 5\ncall eax\nadd esp, 4\nret",
      "timeout_ms": 3000
    },
    {
      "title": "读 g_score 数据槽（绝对寻址）",
      "mode": "code",
      "code": "mov eax, [g_score]\nret",
      "timeout_ms": 3000
    },
    {
      "title": "治疗 50 点",
      "mode": "call",
      "call": "GameHeal",
      "args": ["50"],
      "timeout_ms": 3000
    }
  ]
}
